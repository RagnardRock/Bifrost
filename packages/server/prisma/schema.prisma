generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// AUTHENTICATION
// ============================================

model Admin {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  /// Double authentification : secret de l'appli d'authentification (chiffré), active ou non,
  /// dernier pas de temps accepté (un code ne sert qu'une fois), codes de secours (empreintes)
  totpSecret   String?  @map("totp_secret")
  totpActif    Boolean  @default(false) @map("totp_actif")
  totpDernier  Int?     @map("totp_dernier")
  codesSecours String[] @default([]) @map("codes_secours")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  jetonsDev JetonDev[]

  @@map("admins")
}

/// Une personne (client) : un seul compte et un seul mot de passe, quel que soit le nombre de sites
model User {
  id           String   @id @default(uuid())
  /// toujours en minuscules
  email        String   @unique
  passwordHash String   @map("password_hash")
  /// Double authentification : secret de l'appli d'authentification (chiffré), active ou non,
  /// dernier pas de temps accepté (un code ne sert qu'une fois), codes de secours (empreintes)
  totpSecret   String?  @map("totp_secret")
  totpActif    Boolean  @default(false) @map("totp_actif")
  totpDernier  Int?     @map("totp_dernier")
  codesSecours String[] @default([]) @map("codes_secours")
  /// Notifications sur le téléphone : nouveaux messages, modifications à publier (responsables)
  notifMessages Boolean @default(true) @map("notif_messages")
  notifAPublier Boolean @default(true) @map("notif_a_publier")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  membres        Membre[]
  abonnementsPush AbonnementPush[]
  accesClients   AccesClient[]
  contentHistory ContentHistory[] @relation("ChangedBy")

  @@map("users")
}

/// Un appareil (téléphone, ordinateur) qui reçoit les notifications d'une personne
model AbonnementPush {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("abonnements_push")
}

/// Une personne dans l'équipe d'un site
model Membre {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  siteId    String   @map("site_id")
  /// responsable (publie, gère l'équipe) ou redacteur (modifie le brouillon)
  role      String   @default("responsable")
  /// rempli quand la personne est là par l'accès d'un client (fiche client) : retirée avec lui
  parClient String?  @map("par_client")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([userId, siteId])
  @@index([siteId])
  @@map("membres")
}

// ============================================
// CLIENTS (espace dev : fiche et contrat)
// ============================================

model Client {
  id         String    @id @default(uuid())
  nom        String
  contactNom String?   @map("contact_nom")
  email      String?
  telephone  String?
  adresse    String?
  notes      String    @default("")
  /// essai | actif | suspendu | termine
  statut     String    @default("actif")
  formule    String?
  /// Prix en centimes, par période
  prix       Int?
  /// mois | an | unique
  periode    String?
  debut      DateTime?
  echeance   DateTime?
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  sites Site[]

  acces  AccesClient[]
  jetons Jeton[]

  @@map("clients")
}

/// Une personne qui a accès à tous les sites d'un client (invitée depuis la fiche client).
/// Les sites rattachés plus tard au client lui sont donnés aussi ; un site détaché lui est retiré.
model AccesClient {
  id        String   @id @default(uuid())
  clientId  String   @map("client_id")
  userId    String   @map("user_id")
  role      String   @default("responsable")
  createdAt DateTime @default(now()) @map("created_at")

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clientId, userId])
  @@map("acces_clients")
}

// ============================================
// SITES
// ============================================

model Site {
  id         String   @id @default(uuid())
  name       String
  url        String
  // Nom court dans l'adresse publique : /sites/<slug>/
  slug       String?  @unique
  /// Adresses qui reçoivent les messages des formulaires (séparées par des virgules) ; vide = les responsables du site
  emailMessages String? @map("email_messages")
  apiKey     String   @unique @map("api_key")
  schema     Json?    @db.JsonB
  webhookUrl String?  @map("webhook_url")
  /// Client (fiche et contrat) auquel le site appartient
  clientId   String?  @map("client_id")
  /// En pause : le site en ligne affiche « momentanément indisponible »
  enPause    Boolean  @default(false) @map("en_pause")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  client          Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  membres         Membre[]
  contents        Content[]
  collectionItems CollectionItem[]
  contentHistory  ContentHistory[]
  webhookLogs     WebhookLog[]
  publications    Publication[]
  jetons          Jeton[]
  evenements      Evenement[]
  messages        Message[]
  comptesReseaux  CompteReseau[]

  @@index([clientId])
  @@map("sites")
}

// ============================================
// CONTENT
// ============================================

model Content {
  id        String   @id @default(uuid())
  siteId    String   @map("site_id")
  fieldKey  String   @map("field_key")
  value     Json     @db.JsonB
  version   Int      @default(1)
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, fieldKey])
  @@index([siteId])
  @@map("contents")
}

model CollectionItem {
  id             String   @id @default(uuid())
  siteId         String   @map("site_id")
  collectionType String   @map("collection_type")
  data           Json     @db.JsonB
  position       Int      @default(0)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, collectionType])
  @@map("collection_items")
}

// ============================================
// HISTORY
// ============================================

model ContentHistory {
  id        String   @id @default(uuid())
  siteId    String   @map("site_id")
  fieldKey  String?  @map("field_key")
  itemId    String?  @map("item_id")
  oldValue  Json?    @map("old_value") @db.JsonB
  newValue  Json     @map("new_value") @db.JsonB
  changedAt DateTime @default(now()) @map("changed_at")
  changedBy String?  @map("changed_by")

  site Site  @relation(fields: [siteId], references: [id], onDelete: Cascade)
  user User? @relation("ChangedBy", fields: [changedBy], references: [id], onDelete: SetNull)

  @@index([siteId, fieldKey])
  @@index([siteId, itemId])
  @@index([changedAt])
  @@map("content_history")
}

// ============================================
// WEBHOOKS
// ============================================

model WebhookLog {
  id           String    @id @default(uuid())
  siteId       String    @map("site_id")
  status       String    @default("pending")
  attempts     Int       @default(0)
  lastAttempt  DateTime? @map("last_attempt")
  responseCode Int?      @map("response_code")
  errorMessage String?   @map("error_message")
  payload      Json      @db.JsonB
  createdAt    DateTime  @default(now()) @map("created_at")

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, status])
  @@map("webhook_logs")
}

// ============================================
// PUBLICATIONS (sites statiques, v2)
// ============================================

model Publication {
  id        String   @id @default(uuid())
  siteId    String   @map("site_id")
  auteur    String?
  ajoutes   Json     @db.JsonB
  modifies  Json     @db.JsonB
  supprimes Json     @db.JsonB
  changements Json   @default("[]") @db.JsonB
  annulee   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, createdAt])
  @@map("publications")
}

/// Lien à usage unique envoyé par e-mail : invitation dans l'équipe d'un site, ou mot de passe oublié.
model Jeton {
  id        String    @id @default(uuid())
  type      String
  email     String
  /// invitation dans un site, ou dans tous les sites d'un client
  siteId    String?   @map("site_id")
  clientId  String?   @map("client_id")
  role      String    @default("redacteur")
  hash      String    @unique
  expireLe  DateTime  @map("expire_le")
  utiliseLe DateTime? @map("utilise_le")
  createdAt DateTime  @default(now()) @map("created_at")

  site   Site?   @relation(fields: [siteId], references: [id], onDelete: Cascade)
  client Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([siteId, type])
  @@map("jetons")
}

/// Journal de ce qui se passe sur un site (modifications, publications, équipe), pour le suivi côté dev.
model Evenement {
  id        String   @id @default(uuid())
  siteId    String   @map("site_id")
  auteur    String?
  type      String
  detail    String   @default("")
  createdAt DateTime @default(now()) @map("created_at")

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, createdAt])
  @@index([createdAt])
  @@map("evenements")
}

/// Message envoyé par un visiteur depuis un formulaire du site (data-bf-formulaire).
model Message {
  id         String   @id @default(uuid())
  siteId     String   @map("site_id")
  formulaire String
  /// [{ nom, libelle, valeur }] dans l'ordre du formulaire
  champs     Json     @db.JsonB
  /// Adresse du visiteur si le formulaire en demande une (pour répondre)
  email      String?
  lu         Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at")

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, createdAt])
  @@map("messages")
}

// Jeton d'accès d'un outil du dev (Rune) : long, révocable, seule son empreinte SHA-256 est gardée
model JetonDev {
  id           String    @id @default(uuid())
  adminId      String    @map("admin_id")
  appareil     String    @default("Rune")
  hash         String    @unique
  dernierUsage DateTime? @map("dernier_usage")
  createdAt    DateTime  @default(now()) @map("created_at")

  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@map("jetons_dev")
}

// ============================================
// RÉSEAUX SOCIAUX : posts importés comme actualités
// ============================================

/// Un compte de réseau social relié à un site (Instagram pour l'instant)
model CompteReseau {
  id            String    @id @default(uuid())
  siteId        String    @map("site_id")
  reseau        String    @default("instagram")
  /// identifiant et nom du compte chez le réseau
  compteId      String    @map("compte_id")
  nom           String
  /// jeton d'accès chiffré, et sa date d'expiration (renouvelé tout seul)
  jeton         String
  expireLe      DateTime  @map("expire_le")
  /// collection du site où les posts arrivent (ex. actualites)
  collection    String
  /// brouillon (un responsable relit et publie) ou publier (en ligne tout de suite)
  mode          String    @default("brouillon")
  /// seuls les posts publiés après cette date sont importés automatiquement
  depuis        DateTime  @default(now())
  derniereVerif DateTime? @map("derniere_verif")
  erreur        String?
  createdAt     DateTime  @default(now()) @map("created_at")

  site    Site          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  imports PostImporte[]

  @@unique([siteId, reseau])
  @@map("comptes_reseaux")
}

/// Un post déjà importé (jamais deux fois, même s'il a été supprimé du site depuis)
model PostImporte {
  id        String   @id @default(uuid())
  compteId  String   @map("compte_id")
  postId    String   @map("post_id")
  page      String
  createdAt DateTime @default(now()) @map("created_at")

  compte CompteReseau @relation(fields: [compteId], references: [id], onDelete: Cascade)

  @@unique([compteId, postId])
  @@map("posts_importes")
}
