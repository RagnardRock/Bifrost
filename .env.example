# ===========================================
# Server Configuration
# ===========================================
PORT=3000
NODE_ENV=development

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Log level: debug, info, warn, error
LOG_LEVEL=info

# ===========================================
# Comptes clients (éditeur v2)
# ===========================================
# Adresse de l'interface Bifrost, utilisée dans les liens d'invitation et de mot de passe oublié
APP_URL=http://localhost:5173
# Envoi des e-mails (ex. smtps://utilisateur:motdepasse@smtp.exemple.fr:465).
# Vide : les liens sont écrits dans la console du serveur, et affichés à la personne qui invite.
SMTP_URL=
MAIL_FROM="Bifrost <no-reply@exemple.fr>"
# En ligne : dossier où l'on dépose les sites à importer (on donne alors seulement leur nom).
# Vide en local : on donne le chemin complet du dossier.
IMPORT_DIR=
