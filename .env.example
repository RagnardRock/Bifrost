# ===========================================
# Bifrost Environment Variables
# ===========================================
# Copy this file to .env and fill in your values

# ===========================================
# Database (Required)
# ===========================================
# PostgreSQL connection string
# For Neon.tech: postgresql://user:password@host.neon.tech/dbname?sslmode=require
DATABASE_URL="postgresql://postgres:password@localhost:5432/bifrost"

# ===========================================
# Security (Required in production)
# ===========================================
# JWT secret key (min 32 characters)
# Generate with: openssl rand -hex 32
JWT_SECRET="your-super-secret-key-change-in-production"
# Clé qui chiffre les secrets de double authentification (facultatif : JWT_SECRET sinon).
# Ne pas la changer ensuite, sinon les comptes protégés doivent réactiver leur appli.
# DEUX_FACTEURS_CLE=""
# Double authentification du compte dev : obligatoire en ligne. "facultative" pour la retirer (déconseillé).
# DOUBLE_AUTH_DEV="obligatoire"
