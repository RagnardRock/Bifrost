# Adresse publique de Bifrost (liens des invitations et des mots de passe oubliés)
APP_URL=https://bifrost.ragnardrock.fr

# Envoi des e-mails : smtps://utilisateur:motdepasse@serveur:465
# (dans le mot de passe, @ s'écrit %40, : s'écrit %3A et / s'écrit %2F)
# Vide : pas d'e-mail, le lien s'affiche à la personne qui invite.
SMTP_URL=
MAIL_FROM="Bifrost <bifrost@ragnardrock.fr>"

# Réseaux sociaux : les posts Instagram des clients deviennent des actualités (voir LISEZMOI.md, partie 9)
# Vide : la carte Instagram de Mon site › Réseaux dit « pas encore disponible ».
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# Facultatif
# PORT_LOCAL=3100            port où Caddy retrouve Bifrost sur le VPS
# SITES_DIR=./donnees/sites  fichiers des sites
# IMPORT_DIR=./donnees/import  dossiers déposés pour un import
